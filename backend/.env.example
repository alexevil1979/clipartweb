APP_NAME=ClipArtWeb
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://clipartweb.1tlt.ru
FRONTEND_URL=https://clipartweb.1tlt.ru

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=clipartweb
DB_USERNAME=clipartweb
DB_PASSWORD=

SANCTUM_STATEFUL_DOMAINS=clipartweb.1tlt.ru
SESSION_DOMAIN=.clipartweb.1tlt.ru

QUEUE_CONNECTION=database
CACHE_DRIVER=file
SESSION_DRIVER=file

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@clipartweb.1tlt.ru
MAIL_FROM_NAME=ClipArtWeb

# Stripe
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=rub

# YooKassa (альтернатива)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://clipartweb.1tlt.ru/api/auth/google/callback

# FFmpeg
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
PYTHON_PATH=/usr/bin/python3
RENDER_SCRIPT_PATH=/ssd/www/clipartweb/scripts/render.py

# Storage
STORAGE_PATH=/ssd/www/clipartweb/storage
ASSETS_PATH=/ssd/www/clipartweb/storage/assets
MAX_UPLOAD_SIZE_MB=500
MAX_VIDEO_DURATION_FREE=60
MAX_VIDEO_DURATION_PRO=1800

# Limits
FREE_MAX_ELEMENTS=3
FREE_MAX_RESOLUTION=720
PRO_MAX_RESOLUTION=2160
